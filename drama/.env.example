# Copy to backend/.env for local development. Never commit real values.
DRAMA_ENV=dev
DRAMA_DATABASE_URL=sqlite:///./var/dev.db
DRAMA_STORAGE_DIR=./var/storage
DRAMA_JWT_SECRET=change-me-64-random-chars
DRAMA_MEDIA_SIGNING_SECRET=change-me-32-random-chars
DRAMA_PUBLIC_BASE_URL=http://localhost:8000
DRAMA_CORS_ORIGINS=["http://localhost:3000"]
# Providers (local defaults work without keys)
DRAMA_LLM_PROVIDER=local_template        # anthropic -> requires ANTHROPIC_API_KEY
DRAMA_ANTHROPIC_MODEL=claude-opus-5-5
DRAMA_TTS_PROVIDER=espeak_local          # elevenlabs -> ELEVENLABS_API_KEY (adapter pending)
# ANTHROPIC_API_KEY=
# ELEVENLABS_API_KEY=
# Commercial policy (defaults from spec; require owner approval)
DRAMA_CREATOR_SHARE_BPS=6000
DRAMA_DEFAULT_FREE_EPISODES=5
DRAMA_EARNINGS_HOLD_DAYS=30
DRAMA_SIGNUP_BONUS_CREDITS=1000
DRAMA_DAILY_SPEND_CAP_CREDITS=5000
