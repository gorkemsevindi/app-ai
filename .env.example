# Copy to .env for local development. NEVER commit real secrets; staging/production values come
# from the cloud secrets manager (see docs/DEPLOYMENT.md).
APP_ENV=dev
APP_DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
APP_REDIS_URL=redis://redis:6379/0
APP_JWT_SECRET=change-me-to-a-random-64-char-string
APP_WORKER_TOKENS=["dev-worker-token-change-me"]
APP_S3_ENDPOINT_URL=http://minio:9000
APP_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
APP_S3_ACCESS_KEY_ID=minio
APP_S3_SECRET_ACCESS_KEY=minio-dev-password
APP_S3_BUCKET_PRIVATE=aivideo-private
APP_APPLE_CLIENT_IDS=["com.example.aivideo"]
APP_GOOGLE_CLIENT_IDS=[]
APP_GPU_DAILY_BUDGET_USD=50
# Worker (GPU node)
GPU_PRICE_PER_HOUR=2.5
OUTPUT_SCORER=null
MP_SAFETY_CLASSIFIER=none
