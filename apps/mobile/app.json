{
  "expo": {
    "name": "YourStars",
    "slug": "yourstars",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourstarverse.yourstars",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose photos of yourself to create your identity profile and videos you want to edit.",
        "NSPhotoLibraryAddUsageDescription": "Save your finished videos to your photo library.",
        "NSCameraUsageDescription": "Take selfies for your identity profile.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yourstarverse.yourstars",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-localization",
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of yourself to create your identity profile and videos you want to edit.",
          "cameraPermission": "Take selfies for your identity profile.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save your finished videos to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "scheme": "yourstars",
    "extra": {
      "apiUrl": "http://localhost:8000",
      "privacyUrl": "https://yourstarverse.com/privacy",
      "termsUrl": "https://yourstarverse.com/terms",
      "deleteAccountUrl": "https://yourstarverse.com/delete-account"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
